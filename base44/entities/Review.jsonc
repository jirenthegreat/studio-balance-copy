{
  "name": "Review",
  "type": "object",
  "properties": {
    "author": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "default": 5
    },
    "source": {
      "type": "string"
    },
    "published": {
      "type": "boolean",
      "default": true
    },
    "order": {
      "type": "number"
    }
  },
  "required": [
    "author",
    "text"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.published": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}